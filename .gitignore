**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

## --- MUSUBI (01-05): secretos y artefactos locales nunca van a Git ---
# Configuracion real por ambiente (se versionan solo los *.example.json)
/config/*.json
!/config/*.example.json

# Firebase (HU-31 / 02-01): los genera `flutterfire configure`; en CI se regeneran desde secretos
/lib/firebase_options.dart
/android/app/google-services.json
/firebase.json

# Firma de Android (02-02)
/android/key.properties
*.jks
*.keystore

# Entorno, llaves y certificados
.env
.env.*
*.pem
*.key
*.p12

# Reportes
/test/**/failures/
/reports/
