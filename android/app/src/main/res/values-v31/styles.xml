<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: splash del sistema con los anillos de Musubi (SCRUM-81). Despues sigue el splash
     animado de Flutter con el mismo fondo y los anillos en el mismo lugar. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/musubi_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
